{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecossistema-escola",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "limits": {
    "cpu_ms": 120000
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "RUNTIME_ENVIRONMENT": "production",
    "TENANT_ID": "f04e0fa3-b8dc-4f77-be3c-7dfda0635188",
    "WEB_CLIENT_ID": "78185e20-c824-4acc-9ccd-41b9f7509a6f",
    "GRAPH_CLIENT_ID": "7d565352-1f77-4a7c-a4a4-4ae1b55b5c0c",
    "GROUP_ADMIN_ID": "6b9be4a5-52a4-4e41-8654-1564f14e5ab5",
    "GROUP_PROFESSOR_ID": "96227794-63b1-421c-96f4-cd062fcdf00a",
    "GROUP_ALUNO_ID": "8255b76e-dd85-4d04-a360-8ce1baf6ce63",
    "GROUP_APOIO_ID": "74386ce1-2db4-4352-8618-7ab4659ab7b6",
    "GROUP_VISITANTE_ID": "9b0283b8-8883-4257-8085-3ac60060d489",
    "GROUPS_OWNER_ID": "efd924cd-71c7-49e4-9ebf-f59c8f83eef3",
    "GLOBAL_ADMIN_ROLE_ID": "8d1a70d0-8bda-44c1-a66d-92e28979f5e7",
    "GROUP_RULES_SITE_ID": "eduieda.sharepoint.com,7ea13de9-13ae-40d5-b5f0-ad4782e3f585,d31492d1-c5c1-4710-8f6e-bd38e1fcfb17",
    "GROUP_RULES_LIST_ID": "221d2f8e-4752-4824-8f15-2d1017107c2b",
    "GROUP_STATE_LIST_ID": "5a76f864-a2c2-41e1-ac18-fa620bb01e1c",
    "GROUP_LOG_LIST_ID": "c841eea6-73af-4bbe-8f33-0b6b99fad4b0",
    "OFFICIAL_ORIGIN": "https://admin.escolaieda.com",
    "GRADEBOOK_STORAGE_PROVIDER": "postgres",
    "COLLECTOR_ENABLED": "true"
  },
  "services": [{
    "binding": "PORTAL_SERVICE",
    "service": "student-portal-production",
    "entrypoint": "PortalAdminEntrypoint"
  }, {
    "binding": "PUBLIC_DEMO_CONTROL",
    "service": "portal-aluno-demo-publica",
    "entrypoint": "DemoControl"
  }, {
    "binding": "NOTAS_SYNC_SERVICE",
    "service": "notas-onedrive-sync",
    "entrypoint": "NotasSyncAdminV1"
  }],
  "hyperdrive": [
    {
      "binding": "PROD_DB",
      "id": "476b417597c84b4c994bd36f1a65cb70"
    },
    {
      "binding": "COLLECTOR_DB",
      "id": "74fa00272a0b420582ccb5e55be6356f"
    }
  ]
}
